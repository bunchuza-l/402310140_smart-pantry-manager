<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartPantryManager" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryVariant">@color/primary_dark_green</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent_amber</item>
        <item name="colorSecondaryVariant">@color/accent_amber</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Background color -->
        <item name="android:windowBackground">@color/background_light</item>
    </style>

    <style name="Theme.SmartPantryManager.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryVariant">@color/primary_dark_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_amber</item>
        <item name="android:windowBackground">@color/background_light</item>
    </style>
</resources>
